{
  "name": "threedog-monorepo",
  "private": true,
  "description": "threedog.js monorepo: the engine (packages/engine), its tools (packages/tools) and games (npm workspaces)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penstic123-code/ThreeDog.js-Game-Engine.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/styles/*",
    "games/*"
  ],
  "scripts": {
    "dev": "threedog dev",
    "build": "npm run build --workspaces --if-present",
    "check": "threedog check",
    "types": "threedog types",
    "test": "threedog test",
    "map": "threedog map",
    "shot": "threedog shot",
    "perf": "threedog perf",
    "bake": "threedog bake",
    "assets": "threedog assets",
    "new-game": "threedog new-game",
    "new-style": "threedog new-style",
    "doctor": "threedog doctor"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "fast-check": "^4.10.2",
    "three": "^0.187.0",
    "tweakpane": "^4.0.5"
  }
}
