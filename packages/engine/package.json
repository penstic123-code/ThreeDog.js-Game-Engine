{
  "name": "threedog",
  "version": "0.4.0",
  "description": "Web 3D game engine on three.js for large low-poly worlds: core + modules + style packs, built to be driven by an AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penstic123-code/ThreeDog.js-Game-Engine.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/penstic123-code/ThreeDog.js-Game-Engine#readme",
  "bugs": {
    "url": "https://github.com/penstic123-code/ThreeDog.js-Game-Engine/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./styles/*": {
      "types": "./styles/*/index.d.ts",
      "default": "./styles/*/index.js"
    },
    "./error-hints": "./core/errorHints.js",
    "./worker": {
      "types": "./types/worker.d.ts",
      "default": "./core/threadServe.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "core",
    "modules",
    "render",
    "ui",
    "styles",
    "types",
    "docs",
    "examples",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "threedog test",
    "map": "threedog map"
  },
  "peerDependencies": {
    "three": "^0.187.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@recast-navigation/core": "^0.44.0",
    "@recast-navigation/generators": "^0.44.0",
    "@recast-navigation/three": "^0.44.0",
    "@types/three": "~0.187.0",
    "three-mesh-bvh": "^0.9.17"
  },
  "devDependencies": {
    "@threedog/tools": "*",
    "three": "^0.187.0"
  }
}
