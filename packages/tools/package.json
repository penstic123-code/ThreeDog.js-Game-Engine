{
  "name": "@threedog/tools",
  "version": "0.3.0",
  "description": "Tools shared by the engine and games: the threedog command line, vite preset, test runner, rules, doc generators, bake",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penstic123-code/ThreeDog.js-Game-Engine.git",
    "directory": "packages/tools"
  },
  "homepage": "https://github.com/penstic123-code/ThreeDog.js-Game-Engine#readme",
  "bugs": {
    "url": "https://github.com/penstic123-code/ThreeDog.js-Game-Engine/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "bin": {
    "threedog": "./bin/threedog.mjs"
  },
  "exports": {
    "./vite": "./vite/gameConfig.js",
    "./paths": "./paths.mjs",
    "./browser": "./browser.mjs",
    "./describe-snapshot": "./describe-snapshot.mjs",
    "./look": "./style/look.mjs",
    "./scenario": "./scenario.mjs",
    "./contract": "./contract.mjs",
    "./panel": "./panel/index.js",
    "./gallery": "./gallery/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "*.mjs",
    "*.js",
    "*.html",
    "apidoc",
    "assets-check",
    "bin",
    "content-check",
    "lib",
    "panel",
    "gallery",
    "gamemap",
    "rules",
    "style",
    "templates",
    "threedog",
    "vite"
  ],
  "peerDependencies": {
    "threedog": "^0.3.0",
    "@gltf-transform/cli": "^4.5.1",
    "tweakpane": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@gltf-transform/cli": {
      "optional": true
    },
    "tweakpane": {
      "optional": true
    }
  },
  "dependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
