{
  "name": "@threedog/tools",
  "version": "0.4.0",
  "description": "Tools shared by the engine and games: the threedog command line, vite preset, test runner, rules, doc generators, bake",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penstic123-code/ThreeDog.js-Game-Engine.git",
    "directory": "packages/tools"
  },
  "homepage": "https://github.com/penstic123-code/ThreeDog.js-Game-Engine#readme",
  "bugs": {
    "url": "https://github.com/penstic123-code/ThreeDog.js-Game-Engine/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "bin": {
